{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTS Worksheet Type",
  "type": "object",
  "required": ["version", "worksheet_type_id", "display_name", "status", "compatible_subjects", "template_selection", "validation"],
  "properties": {
    "version": {"type": "string"},
    "worksheet_type_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "draft", "disabled"]},
    "compatible_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "sections": {"type": "array", "items": {"type": "object"}},
    "grade_defaults": {"type": "object"},
    "duration_minutes": {"type": ["integer", "null"], "minimum": 1},
    "scoring": {"type": "object"},
    "template_selection": {
      "type": "object",
      "required": ["template_manifest"],
      "properties": {
        "template_manifest": {"type": "string"},
        "template_key_by_grade": {"type": "object"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["require_verification", "require_visual_qa"],
      "properties": {
        "require_verification": {"type": "boolean"},
        "require_visual_qa": {"type": "boolean"}
      }
    },
    "extension_readiness": {"type": "object"}
  },
  "additionalProperties": false
}